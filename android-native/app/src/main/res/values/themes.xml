<?xml version="1.0" encoding="utf-8"?>
<!--
  Das XML-Theme ist bewusst duenn: Gezeichnet wird alles in Compose, hier steht
  nur, was VOR dem ersten Compose-Bild gilt — der Fensterhintergrund und die
  Systemleisten. Genau derselbe Gedanke wie im Web, wo der Leerzustand schon im
  ausgelieferten HTML steht: Der erste Anstrich soll nicht falsch sein.

  Parent ist Theme.AppCompat, nicht Theme.Material: AppCompat ist ohnehin fuer
  die per-App-Sprachwahl im Baum (siehe build.gradle.kts), und AppCompatActivity
  verlangt ein AppCompat-Theme. Compose Material kommt damit NICHT ins Projekt —
  das XML-Theme faerbt ein Fenster, es liefert keine Bauteile.

  windowBackground traegt das Token `ground` aus src/styles/tokens.css (hell
  #f5f5f5). Die vollstaendige Farbleiter kommt in P3 nach Tokens.kt; hier
  stehen die zwei Werte, die der Systemteil braucht.

  (Die CSS-Token heissen dort mit zwei fuehrenden Bindestrichen. In einem
  XML-Kommentar duerfen die nicht stehen — zwei Bindestriche hintereinander
  beenden nach XML-Regel den Kommentar. Deshalb ueberall hier ohne.)
-->
<resources>
    <style name="Theme.Clockwork" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#f5f5f5</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
