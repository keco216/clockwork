<?xml version="1.0" encoding="utf-8"?>
<!--
  Dunkelfassung. Das Token `ground` ist dort #060607 — Fast-Schwarz, auf dem
  die Flaechen NACH OBEN steigen. Das ist seit v1.2.0 die Richtung der Leiter und
  keine Geschmacksfrage: Nacht auf den Panels liesse darunter hoechstens
  1,122:1 bis Schwarz, aufgeteilt auf zwei Stufen.

  Wie im Web gibt es KEINEN Umschalter — die App folgt der Systemeinstellung.
  Dafuer sorgt der Ressourcen-Qualifier `-night`, das Gegenstueck zu
  `prefers-color-scheme`.
-->
<resources>
    <style name="Theme.Clockwork" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#060607</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
