{
  "compilerOptions": {
    /* Zielumgebung: moderne Browser. ES2022 gibt uns u. a. `DataView.setBigUint64`,
       `Array.prototype.at` und Top-Level-await. */
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],

    /* --- Strenge --- */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    /* Zugriffe wie `bytes[i]` liefern `number | undefined`. Das zwingt uns, überall
       explizit zu prüfen — genau das wollen wir in Krypto-Code. Wo wir garantierte
       Längen haben, benutzen wir `DataView`, das exakt typisierte Getter hat. */
    "noUncheckedIndexedAccess": true,
    /* Ein optionales Feld darf nicht mit `undefined` belegt werden. Erzwingt, dass
       Defaults *vor* dem Aufruf aufgelöst werden statt irgendwo tief drin. */
    "exactOptionalPropertyTypes": true,

    /* --- Modul-Hygiene (Vite/esbuild transpilieren Datei für Datei) --- */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    /* Erlaubt den Import mit `.ts`-Endung. Gebraucht wird das an genau einer
       Stelle: vite.config.ts lädt scripts/locale-subset.ts, und Vites künftiger
       Config-Loader (Nodes eigener TypeScript-Modus) verlangt dort den
       vollständigen Pfad. */
    "allowImportingTsExtensions": true,
    /* `scripts/version.mjs` ist die eine Quelle der Versionsnummer und muss
       `.mjs` bleiben: `store-listing.mjs` und `store-shots.mjs` laufen mit
       blankem `node`, und das lädt kein TypeScript. Drei Tests importieren
       dieselbe Datei — ohne `allowJs` sähe tsc dort nur `any`.

       `checkJs` bleibt AUS: Die Datei wird für die Typherleitung gelesen, nicht
       geprüft. Eine `.d.mts` daneben wäre die Alternative gewesen und genau
       das, was D1b abgeschafft hat — eine zweite Stelle, die mitgepflegt
       werden will. */
    "allowJs": true,

    /* Vite erzeugt das JS, tsc prüft nur die Typen. */
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "scripts", "vite.config.ts"]
}
