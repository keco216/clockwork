# Dependencies
node_modules/

# Build output — both targets plus the temporary dirs the build and the
# subset test write to, plus the staging dir for the Android wrap
dist/
dist-single/
dist-test/
dist-android/
.vite/

# Test and measurement artefacts
coverage/
playwright-report/
test-results/
lighthouse.json

# Screenshots are generated by `npm run shots`. The two images the README
# uses are committed under docs/ instead, so a local run cannot change them.
screenshots/

# Secrets and local overrides — nothing of the sort belongs in this repo
.env
.env.*
*.local

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

